  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : " Any communication resource involved in incident response activities,including channels and individual chat messages"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Responder Communication"
  } ]
}, {
  "@id" : "https://w3id.org/cirpo#SecurityAnalysis",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The analysis of observables from security events leading to an incident"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Security Analysis"
  } ]
}, {
  "@id" : "https://w3id.org/cirpo#SecurityEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
