    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cirpo#Analysis -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Analysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Activities to assess security incidents.</rdfs:comment>
        <rdfs:label>Analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Analyst -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Analyst">
        <rdfs:comment>A security analyst who investigates and responds to incidents.</rdfs:comment>
        <rdfs:label>Analyst</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Artefact -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Artefact">
        <rdfs:comment>An observable piece of evidence collected from an incident.</rdfs:comment>
        <rdfs:label>Artefact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#ChatChannel -->


    <owl:Class rdf:about="https://w3id.org/cirpo#ChatChannel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#ResponderCommunication"/>
        <rdfs:comment>A communication channel where responders exchange messages</rdfs:comment>
        <rdfs:label>Chat Channel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#ChatMessage -->


    <owl:Class rdf:about="https://w3id.org/cirpo#ChatMessage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#ResponderCommunication"/>
        <rdfs:comment>A message posted by a responder within a chat channel.</rdfs:comment>
        <rdfs:label>Chat Message</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Containment -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Containment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Actions to limit the spread and impact of an incident.</rdfs:comment>
        <rdfs:label>Containment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#CourseOfAction -->


    <owl:Class rdf:about="https://w3id.org/cirpo#CourseOfAction">
        <rdfs:comment>A planned response action to a security incident.</rdfs:comment>
        <rdfs:label>Course of Action</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Detection -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Detection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Activities in detection of security incidents.</rdfs:comment>
        <rdfs:label>Detection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Eradication -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Eradication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Actions to remove threats and root causes from affected systems.</rdfs:comment>
        <rdfs:label>Eradication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Incident -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Incident">
        <rdfs:comment>A security incident that requires investigation and response.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#PostIncidentActivity -->


    <owl:Class rdf:about="https://w3id.org/cirpo#PostIncidentActivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Activities conducted after incident resolution (e.g., lessons learned, reporting).</rdfs:comment>
        <rdfs:label>Post-Incident Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Recovery -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Recovery">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Actions to restore systems to normal operation.</rdfs:comment>
        <rdfs:label>Recovery</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#ResponderCommunication -->


    <owl:Class rdf:about="https://w3id.org/cirpo#ResponderCommunication">
        <rdfs:comment> Any communication resource involved in incident response activities,including channels and individual chat messages</rdfs:comment>
        <rdfs:label>Responder Communication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#SecurityAnalysis -->


    <owl:Class rdf:about="https://w3id.org/cirpo#SecurityAnalysis">
        <rdfs:comment>The analysis of observables from security events leading to an incident</rdfs:comment>
        <rdfs:label>Security Analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#SecurityEvent -->


    <owl:Class rdf:about="https://w3id.org/cirpo#SecurityEvent">
        <rdfs:comment>An observable occurrence relevant to system security (e.g., alert from SIEM, IDS).</rdfs:comment>
        <rdfs:label>Security Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#SecurityEventAction -->


    <owl:Class rdf:about="https://w3id.org/cirpo#SecurityEventAction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#SecurityEvent"/>
        <rdfs:comment>A specific action taken or observed within a security event.</rdfs:comment>
        <rdfs:label>Security Event Action</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Tier1 -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Tier1">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>First responder performing initial triage and categorization.</rdfs:comment>
        <rdfs:label>Tier 1</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Tier2 -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Tier2">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Incident responder handling deeper investigation and analysis.</rdfs:comment>
        <rdfs:label>Tier 2</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cirpo#Tier3 -->


    <owl:Class rdf:about="https://w3id.org/cirpo#Tier3">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Senior analyst or subject matter expert handling complex investigations.</rdfs:comment>
        <rdfs:label>Tier 3</rdfs:label>
    </owl:Class>
    


