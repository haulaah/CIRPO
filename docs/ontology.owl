<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/cirpo#"
     xml:base="https://w3id.org/cirpo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/cirpo">
        <owl:versionIRI rdf:resource="https://w3id.org/cirpo/versions/7.0"/>
        <dc:subject>CSIRT</dc:subject>
        <dc:subject>cybersecurity</dc:subject>
        <dc:subject>incident response</dc:subject>
        <dc:subject>ontology</dc:subject>
        <terms:accessRights>public</terms:accessRights>
        <terms:bibliographicCitation>Galadima, H., Doherty, C., &amp; Brennan, R. (2026). Cyber Incident Response Process Ontology (CIRPO) Version 7.0. Zenodo. https://doi.org/10.5281/zenodo.NEW_DOI_PLACEHOLDER</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-09</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator>
            <rdf:Description>
                <foaf:name>Cormac Doherty</foaf:name>
            </rdf:Description>
        </terms:creator>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:description>An ontology for modeling cybersecurity incident response processes</terms:description>
        <terms:isVersionOf rdf:resource="https://doi.org/10.5281/zenodo.20597896"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-12</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher>CCI &amp; ADAPT, School of Computer Science, University College Dublin</terms:publisher>
        <terms:title>Cyber Incident Response Process Ontology (CIRPO)</terms:title>
        <rdfs:seeAlso rdf:resource="https://github.com/moreiragb/csiho"/>
        <rdfs:seeAlso rdf:resource="https://haulaah.github.io/CIRPO/"/>
        <rdfs:seeAlso rdf:resource="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-61r2.pdf"/>
        <owl:priorVersion rdf:resource="https://w3id.org/cirpo/versions/6.0"/>
        <owl:versionInfo>7.0</owl:versionInfo>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <rdfs:seeAlso rdf:resource="https://orcid.org/0009-0003-2485-3067"/>
        <foaf:name>Haula Galadima</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3">
        <rdfs:seeAlso rdf:resource="https://orcid.org/0000-0001-7099-6788"/>
        <foaf:name>Rob Brennan</foaf:name>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/subject -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/subject"/>
    


    <!-- http://purl.org/dc/terms/accessRights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/accessRights"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/isVersionOf -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isVersionOf"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#wasUsedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:comment>Indicates that a course of action used specific analysis</rdfs:comment>
        <rdfs:label>used</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#hadAssociationWith"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cirpo#Analyst"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#Artefact"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Indicates association with an incident</rdfs:comment>
        <rdfs:label>was associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#generated"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityEvent"/>
        <rdfs:comment>Indicates the security event that generated this analysis</rdfs:comment>
        <rdfs:label>was generated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasPerformedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasPerformedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#performed"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityAnalysis"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Indicates the analyst who performed this activity</rdfs:comment>
        <rdfs:label>was performed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#assignedToCoa -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#assignedToCoa">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Inverse of hasCoaAssignedAnalyst. Links an analyst to the courses of action they are assigned to execute.</rdfs:comment>
        <rdfs:label>assigned to COA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#confirmedIncident -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#confirmedIncident">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasConfirmationAnalyst. Links an analyst to the incidents they confirmed.</rdfs:comment>
        <rdfs:label>confirmed incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#containsChat -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#containsChat">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#wasPostedTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#ChatChannel"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#ChatMessage"/>
        <rdfs:comment>Indicates that a channel contains chat messages.</rdfs:comment>
        <rdfs:label>contains chat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#createdArtefact -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#createdArtefact">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Artefact"/>
        <rdfs:comment>Inverse of hasArtefactCreationAnalyst. Links an analyst to the artefacts they created.</rdfs:comment>
        <rdfs:label>created artefact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#createdCoa -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#createdCoa">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Inverse of hasCoaCreationAnalyst. Links an analyst to the courses of action they created.</rdfs:comment>
        <rdfs:label>created COA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#generated -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#generated">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:comment>Inverse of prov:wasGeneratedBy. Indicates a security event generated an analysis.</rdfs:comment>
        <rdfs:label>generated</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#generatedChat -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#generatedChat">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#ChatMessage"/>
        <rdfs:comment>Inverse of hasChatAnalyst.</rdfs:comment>
        <rdfs:label>generated chat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hadAssociationWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hadAssociationWith">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cirpo#Analyst"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#Artefact"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of prov:wasAssociatedWith. Indicates an incident&apos;s associated analyst, artefact, or security event.</rdfs:comment>
        <rdfs:label>had association with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasAnalysis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasAnalysis">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#isAnalysisOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:comment>Links an incident to the security analyses performed on it.</rdfs:comment>
        <rdfs:label>has analysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasAnalysisPerformingAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasAnalysisPerformingAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#performedAnalysis"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links a security analysis to the analyst who performed it.</rdfs:comment>
        <rdfs:label>has analysis performing analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasArtefact -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasArtefact">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#isArtefactOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Artefact"/>
        <rdfs:comment>Links an incident to related artefacts/observables collected during the investigation.</rdfs:comment>
        <rdfs:label>has artefact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasArtefactCreationAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasArtefactCreationAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#createdArtefact"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Artefact"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links an artefact to the analyst who collected, created, or documented it.</rdfs:comment>
        <rdfs:label>has artefact creation analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasChannel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasChannel">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cirpo#hasResponderCommunication"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#ChatChannel"/>
        <rdfs:comment>Links an incident to its chat channel.</rdfs:comment>
        <rdfs:label>has channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasChatAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasChatAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#generatedChat"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#ChatMessage"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links a chat message to the analyst who authored it.</rdfs:comment>
        <rdfs:label>has chat analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasCoa -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasCoa">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#isCoaOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Links an incident to the response actions (COA) taken to resolve it.</rdfs:comment>
        <rdfs:label>has course of action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasCoaAssignedAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasCoaAssignedAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#assignedToCoa"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links a course of action to the analyst responsible for executing it.</rdfs:comment>
        <rdfs:label>has COA assigned analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasCoaCreationAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasCoaCreationAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#createdCoa"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links a course of action to the analyst who created or planned it.</rdfs:comment>
        <rdfs:label>has COA creation analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasConfirmationAnalyst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasConfirmationAnalyst">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#confirmedIncident"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:comment>Links an incident to the analyst who confirmed it as a genuine security incident.</rdfs:comment>
        <rdfs:label>has confirmation analyst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#isEventOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityEvent"/>
        <rdfs:comment>Links an incident to one or more related security events that triggered or are part of it.</rdfs:comment>
        <rdfs:label>has event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#hasResponderCommunication -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#hasResponderCommunication">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#isRelatedToIncident"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#ResponderCommunication"/>
        <rdfs:comment>Links an incident to any responder communication resource.</rdfs:comment>
        <rdfs:label>has responder communication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isAnalysisOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isAnalysisOf">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasAnalysis. Links an analysis back to its incident.</rdfs:comment>
        <rdfs:label>is analysis of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isArtefactOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isArtefactOf">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Artefact"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasArtefact. Links an artefact back to its incident.</rdfs:comment>
        <rdfs:label>is artefact of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isChannelOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isChannelOf">
        <owl:inverseOf rdf:resource="https://w3id.org/cirpo#hasChannel"/>
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#ChatChannel"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasChannel.</rdfs:comment>
        <rdfs:label>is channel of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isCoaOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isCoaOf">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasCoa. Links a course of action back to its incident.</rdfs:comment>
        <rdfs:label>is COA of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isEventOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isEventOf">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasEvent. Links a security event back to its parent incident.</rdfs:comment>
        <rdfs:label>is event of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#isRelatedToIncident -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#isRelatedToIncident">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#ResponderCommunication"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#Incident"/>
        <rdfs:comment>Inverse of hasResponderCommunication. Links any responder communication back to the incident it is associated with.</rdfs:comment>
        <rdfs:label>is related to incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#performed -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#performed">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityAnalysis"/>
                    <rdf:Description rdf:about="https://w3id.org/cirpo#SecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of prov:wasPerformedBy. Indicates an analyst performed an activity.</rdfs:comment>
        <rdfs:label>performed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#performedAnalysis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#performedAnalysis">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#Analyst"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:comment>Inverse of hasAnalysisPerformingAnalyst. Links an analyst to the analyses they performed.</rdfs:comment>
        <rdfs:label>performed analysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#wasPostedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#wasPostedTo">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#ChatMessage"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#ChatChannel"/>
        <rdfs:comment>Indicates the channel where the chat message was posted.</rdfs:comment>
        <rdfs:label>was posted to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cirpo#wasUsedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cirpo#wasUsedBy">
        <rdfs:domain rdf:resource="https://w3id.org/cirpo#SecurityAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/cirpo#CourseOfAction"/>
        <rdfs:comment>Inverse of prov:used. Indicates an analysis was used by a course of action.</rdfs:comment>
        <rdfs:label>was used by</rdfs:label>
    </owl:ObjectProperty>
    


