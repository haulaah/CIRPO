    <owl:NamedIndividual rdf:about="https://doi.org/10.5281/zenodo.NEW_DOI_PLACEHOLDER">
        <owl:sameAs rdf:resource="https://w3id.org/cirpo"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cirpo -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cirpo"/>
    


    <!-- https://w3id.org/cirpo -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cirpo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
